# Orqiva ERP Environment Configuration
# Node & App
NODE_ENV="development"
PORT=3000
APP_URL="http://localhost:3000"

# PostgreSQL Database (Local: 127.0.0.1, Docker: db)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/orqiva_erp?schema=public&connection_limit=20&pool_timeout=10"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/orqiva_erp?schema=public"

# Redis & Background Jobs (Local: 127.0.0.1, Docker: redis)
REDIS_HOST="127.0.0.1"
REDIS_PORT=6379
REDIS_PASSWORD=""

# Security & Authentication (JWT & Session)
JWT_SECRET="orqiva-enterprise-super-secret-key-change-in-production-min-32-chars"
JWT_EXPIRES_IN="8h"
SESSION_SECRET="orqiva-session-secret-change-in-production"

# Compliance & Auditing (SOC2 / GDPR)
AUDIT_LOG_RETENTION_DAYS=2555 # 7 years statutory retention
DATA_ENCRYPTION_KEY="32-byte-base64-encoded-encryption-key-here"
