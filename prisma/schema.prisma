// Orqiva ERP - Prisma Schema
// Optimized for PostgreSQL Enterprise Scale, High Concurrency & Multi-Tenancy

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// -------------------------------------------------------------
// CORE & RBAC DOMAIN (SOC-2 & GDPR COMPLIANT)
// -------------------------------------------------------------

enum UserRole {
  SUPER_ADMIN
  ACCOUNTANT
  INVENTORY_MANAGER
  CASHIER
  HR_MANAGER
  AUDITOR
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  INVITED
  DEACTIVATED
}

model Tenant {
  id          String   @id @default(cuid())
  name        String
  code        String   @unique
  currency    String   @default("USD")
  fiscalYearStartMonth Int @default(1)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       User[]
  warehouses  Warehouse[]
  products    Product[]
  categories  ProductCategory[]
  journals    Journal[]
  accounts    Account[]
  employees   Employee[]
  auditLogs   AuditLog[]
  vendors     Vendor[]
  purchaseOrders PurchaseOrder[]
  goodsReceipts  GoodsReceipt[]
  eInvoices       EInvoice[]
  transfers       StockTransfer[]
  adjustments     StockAdjustment[]

  @@map("tenants")
}

model User {
  id            String     @id @default(cuid())
  tenantId      String
  email         String
  passwordHash  String
  fullName      String
  role          UserRole   @default(CASHIER)
  status        UserStatus @default(ACTIVE)
  phoneNumber   String?
  mfaEnabled    Boolean    @default(false)
  lastLoginAt   DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  tenant        Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  auditLogs     AuditLog[]
  posSessions   PosSession[]
  stockMovesCreated StockMove[] @relation("StockMoveCreator")

  @@unique([tenantId, email])
  @@index([tenantId, role, status])
  @@map("users")
}

// -------------------------------------------------------------
// IMMUTABLE AUDIT TRAIL (SOC-2 / GDPR EVIDENCE)
// -------------------------------------------------------------

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  POST_LEDGER
  REVERSE_LEDGER
  STOCK_ADJUSTMENT
  POS_CLOSE_SESSION
  SECURITY_LOGIN
  SECURITY_FAILED_AUTH
}

model AuditLog {
  id          String      @id @default(cuid())
  tenantId    String
  actorId     String?
  action      AuditAction
  entityType  String
  entityId    String
  ipAddress   String?
  userAgent   String?
  beforeState Json?
  afterState  Json?
  metadata    Json?
  createdAt   DateTime    @default(now())

  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  actor       User?       @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([tenantId, entityType, entityId, createdAt])
  @@index([tenantId, actorId, createdAt])
  @@index([tenantId, action, createdAt])
  @@map("audit_logs")
}

// -------------------------------------------------------------
// INVENTORY DOMAIN (ODOO-COMPATIBLE MULTI-WAREHOUSE & ROUTING)
// -------------------------------------------------------------

enum LocationType {
  INTERNAL
  VENDOR
  CUSTOMER
  TRANSIT
  INVENTORY_LOSS
  PRODUCTION
}

enum ValuationMethod {
  FIFO
  AVCO
  STANDARD
}

model Warehouse {
  id          String     @id @default(cuid())
  tenantId    String
  name        String
  code        String
  address     String?
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  tenant      Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  locations   Location[]
  purchaseOrders PurchaseOrder[]

  @@unique([tenantId, code])
  @@index([tenantId, isActive])
  @@map("warehouses")
}

model Location {
  id          String       @id @default(cuid())
  tenantId    String
  warehouseId String?
  name        String
  barcode     String?
  type        LocationType @default(INTERNAL)
  parentId    String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  warehouse   Warehouse?   @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  parent      Location?    @relation("LocationHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children    Location[]   @relation("LocationHierarchy")
  quants      StockQuant[]
  incomingMoves StockMove[] @relation("StockMoveDestLocation")
  outgoingMoves StockMove[] @relation("StockMoveSrcLocation")
  goodsReceipts GoodsReceipt[]
  transfersOut  StockTransfer[] @relation("TransferSourceLocation")
  transfersIn   StockTransfer[] @relation("TransferDestLocation")
  adjustments   StockAdjustment[]

  @@index([warehouseId, type])
  @@index([tenantId, type])
  @@map("locations")
}

model ProductCategory {
  id              String          @id @default(cuid())
  tenantId        String
  name            String
  code            String
  valuationMethod ValuationMethod @default(AVCO)
  inventoryValuationAccountId String?
  stockInputAccountId         String?
  stockOutputAccountId        String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  tenant          Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  products        Product[]

  @@unique([tenantId, code])
  @@map("product_categories")
}

model Product {
  id            String          @id @default(cuid())
  tenantId      String
  categoryId    String
  sku           String
  barcode       String?
  name          String
  description   String?
  uom           String          @default("Units") // Unit of measure
  costPrice     Decimal         @default(0.0) @db.Decimal(18, 4)
  sellingPrice  Decimal         @default(0.0) @db.Decimal(18, 4)
  taxRate       Decimal         @default(0.0) @db.Decimal(5, 2) // e.g. 15.00%
  minStockAlert Decimal         @default(10.0) @db.Decimal(14, 4)
  isActive      Boolean         @default(true)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  tenant        Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category      ProductCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  quants        StockQuant[]
  stockMoveLines StockMoveLine[]
  posOrderLines PosOrderLine[]
  purchaseOrderItems PurchaseOrderItem[]
  goodsReceiptItems  GoodsReceiptItem[]
  transferLines      StockTransferLine[]
  adjustmentLines    StockAdjustmentLine[]

  @@unique([tenantId, sku])
  @@index([tenantId, categoryId, isActive])
  @@index([tenantId, barcode])
  @@map("products")
}

// High-concurrency row-level stock quant
// Critical: strict unique constraint on (tenantId, productId, locationId)
model StockQuant {
  id                String   @id @default(cuid())
  tenantId          String
  productId         String
  locationId        String
  quantity          Decimal  @default(0.0) @db.Decimal(14, 4)
  reservedQuantity  Decimal  @default(0.0) @db.Decimal(14, 4)
  version           Int      @default(0) // Optimistic concurrency control counter
  updatedAt         DateTime @updatedAt

  product           Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  location          Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([tenantId, productId, locationId])
  @@index([tenantId, productId])
  @@index([tenantId, locationId])
  @@map("stock_quants")
}

enum StockMoveState {
  DRAFT
  WAITING
  CONFIRMED
  ASSIGNED // Reserved
  DONE
  CANCELLED
}

model StockMove {
  id                String         @id @default(cuid())
  tenantId          String
  reference         String         // e.g. WH/IN/0001, WH/OUT/0001
  sourceLocationId  String
  destLocationId    String
  state             StockMoveState @default(DRAFT)
  scheduledDate     DateTime       @default(now())
  dateDone          DateTime?
  originDocument    String?        // PO, SO, or POS Order ID
  createdById       String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  sourceLocation    Location       @relation("StockMoveSrcLocation", fields: [sourceLocationId], references: [id])
  destLocation      Location       @relation("StockMoveDestLocation", fields: [destLocationId], references: [id])
  createdBy         User?          @relation("StockMoveCreator", fields: [createdById], references: [id], onDelete: SetNull)
  lines             StockMoveLine[]

  @@index([tenantId, state, scheduledDate])
  @@index([tenantId, reference])
  @@map("stock_moves")
}

model StockMoveLine {
  id              String    @id @default(cuid())
  stockMoveId     String
  productId       String
  qtyDemand       Decimal   @db.Decimal(14, 4)
  qtyDone         Decimal   @default(0.0) @db.Decimal(14, 4)
  unitCost        Decimal   @default(0.0) @db.Decimal(18, 4)

  stockMove       StockMove @relation(fields: [stockMoveId], references: [id], onDelete: Cascade)
  product         Product   @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([stockMoveId])
  @@index([productId])
  @@map("stock_move_lines")
}

// -------------------------------------------------------------
// ACCOUNTING DOMAIN (STRICT DOUBLE-ENTRY LEDGER)
// Invariant: SUM(debit) == SUM(credit) for every posted entry
// -------------------------------------------------------------

enum AccountType {
  ASSET_CURRENT
  ASSET_NON_CURRENT
  LIABILITY_CURRENT
  LIABILITY_NON_CURRENT
  EQUITY
  INCOME
  EXPENSE
  COST_OF_REVENUE
}

enum JournalType {
  SALE
  PURCHASE
  CASH
  BANK
  GENERAL
}

enum EntryState {
  DRAFT
  POSTED
  CANCELLED
}

model Account {
  id          String      @id @default(cuid())
  tenantId    String
  code        String      // e.g. 1010, 2000, 4000
  name        String      // e.g. "Main Cash", "Accounts Receivable"
  type        AccountType
  isActive    Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  journalItems JournalItem[]

  @@unique([tenantId, code])
  @@index([tenantId, type, isActive])
  @@map("accounts")
}

model Journal {
  id          String      @id @default(cuid())
  tenantId    String
  code        String      // e.g. CS, BNK, GEN
  name        String
  type        JournalType
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  entries     JournalEntry[]

  @@unique([tenantId, code])
  @@map("journals")
}

model JournalEntry {
  id              String      @id @default(cuid())
  tenantId        String
  journalId       String
  entryNumber     String      // e.g. JE-2026-00001
  date            DateTime    @default(now())
  reference       String?
  narrative       String?
  state           EntryState  @default(DRAFT)
  postedAt        DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  journal         Journal     @relation(fields: [journalId], references: [id], onDelete: Restrict)
  items           JournalItem[]

  @@unique([tenantId, entryNumber])
  @@index([tenantId, journalId, date])
  @@index([tenantId, state, date])
  @@map("journal_entries")
}

model JournalItem {
  id              String       @id @default(cuid())
  tenantId        String
  entryId         String
  accountId       String
  label           String?
  debit           Decimal      @default(0.0) @db.Decimal(18, 4)
  credit          Decimal      @default(0.0) @db.Decimal(18, 4)
  reconciled      Boolean      @default(false)
  createdAt       DateTime     @default(now())

  entry           JournalEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  account         Account      @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@index([tenantId, accountId])
  @@index([entryId])
  @@map("journal_items")
}

// -------------------------------------------------------------
// POINT OF SALE (POS) DOMAIN
// -------------------------------------------------------------

enum PosSessionState {
  OPENING_CONTROL
  OPENED
  CLOSING_CONTROL
  CLOSED
}

model PosSession {
  id              String          @id @default(cuid())
  tenantId        String
  cashierId       String
  sessionNumber   String          // e.g. POS-SESS-00045
  state           PosSessionState @default(OPENED)
  openingBalance  Decimal         @default(0.0) @db.Decimal(18, 4)
  closingBalance  Decimal?        @db.Decimal(18, 4)
  totalSales      Decimal         @default(0.0) @db.Decimal(18, 4)
  openedAt        DateTime        @default(now())
  closedAt        DateTime?

  cashier         User            @relation(fields: [cashierId], references: [id], onDelete: Restrict)
  orders          PosOrder[]

  @@unique([tenantId, sessionNumber])
  @@index([tenantId, cashierId, state])
  @@map("pos_sessions")
}

model PosOrder {
  id              String       @id @default(cuid())
  tenantId        String
  sessionId       String
  orderNumber     String       // e.g. POS-ORD-0001
  totalAmount     Decimal      @db.Decimal(18, 4)
  taxAmount       Decimal      @default(0.0) @db.Decimal(18, 4)
  discountAmount  Decimal      @default(0.0) @db.Decimal(18, 4)
  paymentMethod   String       // CASH, CARD, SPLIT
  qrCode          String?      @db.Text
  invoiceHash     String?
  previousHash    String?
  createdAt       DateTime     @default(now())

  session         PosSession   @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  lines           PosOrderLine[]
  eInvoice        EInvoice?

  @@unique([tenantId, orderNumber])
  @@index([tenantId, sessionId, createdAt])
  @@map("pos_orders")
}

model PosOrderLine {
  id              String    @id @default(cuid())
  orderId         String
  productId       String
  quantity        Decimal   @db.Decimal(14, 4)
  unitPrice       Decimal   @db.Decimal(18, 4)
  taxAmount       Decimal   @default(0.0) @db.Decimal(18, 4)
  subtotal        Decimal   @db.Decimal(18, 4)

  order           PosOrder  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product         Product   @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([productId])
  @@map("pos_order_lines")
}

// -------------------------------------------------------------
// HUMAN RESOURCES (HR) DOMAIN
// -------------------------------------------------------------

model Employee {
  id              String    @id @default(cuid())
  tenantId        String
  employeeCode    String    // e.g. EMP-001
  firstName       String
  lastName        String
  email           String
  department      String
  position        String
  basicSalary     Decimal   @db.Decimal(18, 4)
  isActive        Boolean   @default(true)
  joinedDate      DateTime
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  tenant          Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, employeeCode])
  @@index([tenantId, department, isActive])
  @@map("employees")
}

// -------------------------------------------------------------
// PROCUREMENT & SUPPLIER DOMAIN (PROCURE-TO-PAY)
// -------------------------------------------------------------

enum PurchaseOrderStatus {
  DRAFT
  CONFIRMED
  RECEIVED
  BILLED
  CANCELLED
}

enum GoodsReceiptStatus {
  PENDING
  COMPLETED
  CANCELLED
}

model Vendor {
  id            String          @id @default(cuid())
  tenantId      String
  name          String
  code          String
  taxId         String?         // e.g. VAT / Tax Reg ID
  email         String?
  phone         String?
  address       String?
  currency      String          @default("USD")
  paymentTerms  String          @default("NET30") // NET15, NET30, NET60, DUE_ON_RECEIPT
  balance       Decimal         @default(0.0) @db.Decimal(18, 4) // Outstanding AP balance
  isActive      Boolean         @default(true)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  tenant        Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  purchaseOrders PurchaseOrder[]

  @@unique([tenantId, code])
  @@index([tenantId, isActive])
  @@map("vendors")
}

model PurchaseOrder {
  id            String              @id @default(cuid())
  tenantId      String
  vendorId      String
  warehouseId   String
  orderNumber   String              // e.g. PO-2026-0001
  status        PurchaseOrderStatus @default(DRAFT)
  totalAmount   Decimal             @default(0.0) @db.Decimal(18, 4)
  taxAmount     Decimal             @default(0.0) @db.Decimal(18, 4)
  notes         String?
  orderDate     DateTime            @default(now())
  expectedDate  DateTime?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  tenant        Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  vendor        Vendor              @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  warehouse     Warehouse           @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  items         PurchaseOrderItem[]
  receipts      GoodsReceipt[]

  @@unique([tenantId, orderNumber])
  @@index([tenantId, vendorId, status])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id               String        @id @default(cuid())
  purchaseOrderId  String
  productId        String
  quantity         Decimal       @db.Decimal(14, 4)
  unitPrice        Decimal       @db.Decimal(18, 4)
  taxRate          Decimal       @default(0.0) @db.Decimal(5, 2)
  subtotal         Decimal       @db.Decimal(18, 4)
  receivedQuantity Decimal       @default(0.0) @db.Decimal(14, 4)

  purchaseOrder    PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  product          Product       @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([purchaseOrderId])
  @@index([productId])
  @@map("purchase_order_items")
}

model GoodsReceipt {
  id              String             @id @default(cuid())
  tenantId        String
  purchaseOrderId String
  locationId      String
  receiptNumber   String             // e.g. GR-2026-0001
  status          GoodsReceiptStatus @default(COMPLETED)
  receivedAt      DateTime           @default(now())
  receivedById    String?
  notes           String?
  createdAt       DateTime           @default(now())

  tenant          Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  purchaseOrder   PurchaseOrder      @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  location        Location           @relation(fields: [locationId], references: [id], onDelete: Restrict)
  items           GoodsReceiptItem[]

  @@unique([tenantId, receiptNumber])
  @@index([tenantId, purchaseOrderId])
  @@map("goods_receipts")
}

model GoodsReceiptItem {
  id               String       @id @default(cuid())
  goodsReceiptId   String
  productId        String
  quantityReceived Decimal      @db.Decimal(14, 4)
  unitCost         Decimal      @db.Decimal(18, 4)

  goodsReceipt     GoodsReceipt @relation(fields: [goodsReceiptId], references: [id], onDelete: Cascade)
  product          Product      @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([goodsReceiptId])
  @@index([productId])
  @@map("goods_receipt_items")
}

// -------------------------------------------------------------
// COMPLIANCE & FISCAL E-INVOICING (ZATCA / CRYPTOGRAPHIC LEDGER)
// -------------------------------------------------------------

model EInvoice {
  id                  String   @id @default(cuid())
  tenantId            String
  invoiceNumber       String
  issueDate           DateTime @default(now())
  sellerName          String
  vatNumber           String
  customerName        String?
  customerVat         String?
  subtotal            Decimal  @db.Decimal(18, 4)
  taxAmount           Decimal  @db.Decimal(18, 4)
  totalAmount         Decimal  @db.Decimal(18, 4)
  previousHash        String
  invoiceHash         String
  tlvBase64           String   @db.Text
  posOrderId          String?  @unique
  createdAt           DateTime @default(now())

  tenant              Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  posOrder            PosOrder? @relation(fields: [posOrderId], references: [id], onDelete: SetNull)

  @@unique([tenantId, invoiceNumber])
  @@index([tenantId, issueDate])
  @@map("e_invoices")
}

// -------------------------------------------------------------
// MULTI-BRANCH STOCK TRANSFERS & PHYSICAL STOCKTAKE RECONCILIATION
// -------------------------------------------------------------

enum StockTransferStatus {
  DRAFT
  IN_TRANSIT
  COMPLETED
  CANCELLED
}

enum AdjustmentReason {
  SPOILAGE
  SHRINKAGE
  COUNT_CORRECTION
  FOUND
}

enum AdjustmentStatus {
  DRAFT
  POSTED
  CANCELLED
}

model StockTransfer {
  id                  String              @id @default(cuid())
  tenantId            String
  transferNumber      String              // e.g. TR-2026-0001
  sourceLocationId    String
  destLocationId      String
  status              StockTransferStatus @default(DRAFT)
  dispatchedAt        DateTime?
  receivedAt          DateTime?
  notes               String?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  tenant              Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sourceLocation      Location            @relation("TransferSourceLocation", fields: [sourceLocationId], references: [id], onDelete: Restrict)
  destLocation        Location            @relation("TransferDestLocation", fields: [destLocationId], references: [id], onDelete: Restrict)
  lines               StockTransferLine[]

  @@unique([tenantId, transferNumber])
  @@index([tenantId, status])
  @@map("stock_transfers")
}

model StockTransferLine {
  id                  String        @id @default(cuid())
  transferId          String
  productId           String
  quantity            Decimal       @db.Decimal(14, 4)
  receivedQty         Decimal       @default(0.0) @db.Decimal(14, 4)

  transfer            StockTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  product             Product       @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([transferId])
  @@index([productId])
  @@map("stock_transfer_lines")
}

model StockAdjustment {
  id                  String            @id @default(cuid())
  tenantId            String
  adjustmentNumber    String            // e.g. ADJ-2026-0001
  locationId          String
  reason              AdjustmentReason
  status              AdjustmentStatus  @default(DRAFT)
  notes               String?
  postedAt            DateTime?
  journalEntryId      String?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  tenant              Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  location            Location          @relation(fields: [locationId], references: [id], onDelete: Restrict)
  lines               StockAdjustmentLine[]

  @@unique([tenantId, adjustmentNumber])
  @@index([tenantId, status])
  @@map("stock_adjustments")
}

model StockAdjustmentLine {
  id                  String          @id @default(cuid())
  adjustmentId        String
  productId           String
  systemQuantity      Decimal         @db.Decimal(14, 4)
  countedQuantity     Decimal         @db.Decimal(14, 4)
  varianceQuantity    Decimal         @db.Decimal(14, 4)
  unitCost            Decimal         @db.Decimal(18, 4)
  totalCostVariance   Decimal         @db.Decimal(18, 4)

  adjustment          StockAdjustment @relation(fields: [adjustmentId], references: [id], onDelete: Cascade)
  product             Product         @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([adjustmentId])
  @@index([productId])
  @@map("stock_adjustment_lines")
}


